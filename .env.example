# Copy to .env and fill in. Never commit .env.

# Flask session / CSRF (any long random string)
SECRET_KEY=change-me-to-a-long-random-string

# Shared SSH settings for all monitored hosts
SSH_USER=monitor
SSH_PORT=22
# Prefer a key; leave SSH_PASSWORD empty when using a key
SSH_KEY_PATH=/path/to/private_key
SSH_PASSWORD=
